# Executor authority mode. Required: anything else leaves the executor unconfigured (fails closed).
#   fallback = reference policy + Tide-authenticated approvals; every receipt says SIMULATED_AUTHORITY
#   live     = only a Tide signature from the pinned key settles (needs the Forseti contract deployed)
AUTHORITY_MODE=fallback
# Optional: SQLite file (default ./data/covenant.db)
# COVENANT_DB=./data/covenant.db
